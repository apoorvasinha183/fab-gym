; Engine configuration file.

config_version=5

[application]

config/name="Fab Gym explore"
config/description="A gigafab-style layout of our own design on the SMT2020 model, to walk and fly through. Not a real fab."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
environment/defaults/default_clear_color=Color(0.62, 0.72, 0.84, 1)
