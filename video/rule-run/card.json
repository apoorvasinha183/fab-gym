   "source": "pub fn key(c: &Cand, x: &Ctx) -> f64 {\n    let lots = c.lots.max(1.0);\n    let per_lot = c.proc_minutes / lots;\n    let q = x.queue;\n    let idle = x.idle;\n    let is_bneck = q > 11.0 && idle < 1.0;\n\n    let mut k = 0.0;\n    // throughput costs\n    k += c.setup_change * 70.0;\n    k += per_lot * 0.60;\n    k += c.work_left_minutes.ln_1p() * 0.75;\n    k += c.steps_left * 0.32;\n    k += c.size_wafers * 0.02;\n    if c.family == 2.0 {\n        k += 9.5;\n    }\n    // flow benefits\n    k -= c.lots * 28.0;\n    k -= c.is_batch * 16.0;\n    k -= c.priority * 72.0;\n    k -= c.waited_minutes * 0.14;\n    k -= c.age_minutes * 0.005;\n\n    // very light CQT, only imminent breach\n    let s = c.cqt_slack_minutes;\n    if s < 1e8 && s < 35.0 {\n        let mut b = (35.0 - s) * 0.60;\n        if b > 50.0 { b = 50.0; }\n        k -= b;\n    }\n\n    // polishing bottleneck adaptation\n    if is_bneck {\n        // at bottleneck maximize throughput: avoid setup, prefer full batches, SPT\n        k += c.setup_change * 16.0;\n        k -= c.lots * 7.0;\n        k += per_lot * 0.15;\n        k += c.work_left_minutes.ln_1p() * 0.20;\n        // scale slightly with queue depth\n        k += c.setup_change * q * 0.35;\n        k -= c.lots * q * 0.08;\n    } else {\n        // upstream/downstream keep flow to bottleneck\n        k -= c.waited_minutes * 0.05;\n    }\n\n    // anti-starvation for very long waiters\n    if c.waited_minutes > 340.0 {\n        k -= (c.waited_minutes - 340.0) * 0.028;\n    }\n\n    if c.is_default == 1.0 {\n        k -= 0.0008;\n    }\n    if !k.is_finite() {\n        return 0.0;\n    }\n    k\n}",
